# Configure real vendor CLI wrappers in the worker environment.
# Commands receive these placeholders:
# {prompt_file} {target} {scenario} {attempt} {output_file}
PROMPTFOO_COMMAND=
PYRIT_COMMAND=
GARAK_COMMAND=
STRIKER_COMMAND=

# Phase 5 security
AUTH_REQUIRED=true
# Comma separated name:key:role entries. Replace immediately in real deployments.
REDTEAM_API_KEYS=admin:change-me:admin,analyst:change-me-analyst:analyst,auditor:change-me-auditor:auditor
VITE_API_KEY=change-me
